{
	"name": "@kuchta/radixverse",
	"version": "0.2.0",
	"repository": "kuchta/radixverse",
	"homepage": "https://kuchta.github.io/radixverse",
	"exports": "./src/radixes.ts",
	"nodeModulesDir": "auto",
	"exclude": [ ".history" ],
	"tasks": {
	// 	"start": "vite --host --port 10000",
	// 	"preview": "vite preview --port 10000",
	// 	"check": "deno check",
	// 	"lint": "deno lint",
	// 	"test": "deno test",
	// 	"build": "vite build",
	// 	"pre-commit": "deno task check && deno task lint && deno task test && deno task build",
	// 	"deploy": {
	// 		"command": "deno deploy dist",
	// 		"dependencies": [ "build" ]
	// 	}
		"serve": "deno run --allow-net --allow-read --allow-env deno-serve.ts",
		"desktop": "deno desktop ."
	},
	"desktop": {
		"app": {
			"name": "RadixVerse",
			"icons": {
				"macos": "./public/images/icon-512x512.png",
				"windows": "./public/images/icon-512x512.png",
				"linux": "./public/images/icon-512x512.png"
			}
		},
		"output": {
			"macos": "./dist/RadixVerse.dmg",
			"windows": "./dist/RadixVerse.msi",
			"linux": "./dist/RadixVerse.AppImage"
		}
	},
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"lib": [ "ESNext", "DOM", "DOM.Iterable", "deno.ns" ],
		"types": [ "node", "vite/client" ]
	},
	"lint": {
		"rules": {
			"tags": [ "recommended" ],
			"exclude": [ "jsx-button-has-type", "no-cond-assign", "no-process-global", "no-sloppy-imports" ]
		}
	},
	"publish": {
		"include": [ "README.md", "deno.json", "package.json", "src/radixes.ts" ]
	},
	"deploy": {
		"org": "kuchta",
		"app": "radixverse"
	}
}
